{
  "name": "cloudflare-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "node scripts/run-local.mjs vite --host 127.0.0.1",
    "build": "node scripts/run-local.mjs vite build",
    "preview": "node scripts/run-local.mjs vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "node scripts/run-local.mjs vitest run --config vitest.worker.config.ts",
    "deploy:dry-run": "node scripts/run-local.mjs wrangler deploy --dry-run",
    "measure:local": "tsx scripts/measure-local.ts",
    "db:migrate": "node scripts/run-local.mjs wrangler d1 migrations apply DB --local",
    "setup:local": "node scripts/setup-local.mjs && npm run db:migrate",
    "generate:types": "node scripts/run-local.mjs wrangler types",
    "format": "prettier --write src worker shared tests scripts vite.config.ts vitest.config.ts vitest.worker.config.ts eslint.config.js package.json tsconfig.json components.json"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "lossless-json": "^4.3.3",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
