{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node", "@cloudflare/vitest-plugin/types"],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "worker", "shared", "tests", "scripts", "*.ts", "worker-configuration.d.ts"]
}
